# Copy to .env (make up does this for you if .env is missing). Never commit .env.

# development (or test) allows the development defaults below. Anything else, or leaving this
# unset, is treated as a real deployment: the API then refuses to start with development
# secrets, EMAIL_BACKEND=console or SESSION_COOKIE_SECURE=false.
ENVIRONMENT=development

# LLM providers (needed from prompt 07 on; M1 never calls them)
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible proxy for the Anthropic requests (for example Teamorouter,
# https://api.teamorouter.com). Its key goes in ANTHROPIC_API_KEY. Empty = the Anthropic API.
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
# The agents call the providers only with LLM_LIVE=true (off during the API hold, 2026-11-14).
LLM_LIVE=false

# Local tools (uv run ...) talk to the Compose services on localhost.
# Containers get their own host names from docker-compose.yml.
POSTGRES_USER=quarterly
POSTGRES_PASSWORD=quarterly
POSTGRES_DB=quarterly
DATABASE_URL=postgresql+psycopg://quarterly:quarterly@localhost:5432/quarterly
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=quarterly
MINIO_ROOT_PASSWORD=quarterly-dev-secret
MINIO_BUCKET=snapshots

# Secrets: replace with long random values outside development
# (python -c "import secrets; print(secrets.token_urlsafe(48))")
SERVER_HMAC_KEY=dev-only-server-hmac-key
ISSUANCE_HMAC_KEY=dev-only-issuance-hmac-key
SESSION_SECRET=dev-only-session-secret

# Development only: show program versions that are still in review (M1 seed data).
SHOW_UNPUBLISHED_PROGRAMS=true

# Accounts. The session cookie is Secure by default; turn that off only for local http.
SESSION_COOKIE_SECURE=false
# console prints verification codes to the API's stdout (never the address); smtp sends mail.
EMAIL_BACKEND=console
# EMAIL_FROM=Quarterly <no-reply@example.edu>
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=
# Reverse proxies that append the client address to X-Forwarded-For (rate limits only).
TRUSTED_PROXY_HOPS=0

# Catalog ingestion (prompt 09). The annual run and the monthly change check do nothing unless
# CATALOG_INGEST_ENABLED=true. The crawler sends CATALOG_CONTACT_EMAIL in its user agent so the
# catalog's operators can reach us, and refuses to fetch anything without it (never logged).
CATALOG_INGEST_ENABLED=false
CATALOG_CONTACT_EMAIL=
# CATALOG_BASE_URL=https://collegecatalog.uchicago.edu
# CATALOG_TARGET_YEAR=2027-28
# Stop calling models once a run has spent this much (USD, list prices).
INGEST_COST_CAP_USD=25

# Schedule pipeline (prompt 10). The Class Search scraper and its weekly watch send NO request
# unless this is true. Keep it false until Richard confirms in writing that the University
# permits scraping (docs/OPEN_QUESTIONS.md, "Prompt 10").
SCHEDULE_SCRAPER_ENABLED=false
# The guest Class Search start page; unset on purpose (the scraper refuses to run without it).
# CLASS_SEARCH_URL=
# SCRAPER_DELAY_S=1.0

# Prompt 12: seconds each API process keeps a catalog year in memory when loading plan inputs
# (docker-compose sets 60 for the api). 0 = query every time.
RULES_CACHE_TTL_S=60
# Seconds a forum page header is reused per API process (docker-compose sets 5).
PAGE_CACHE_TTL_S=5
