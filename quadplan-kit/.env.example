# Copy to .env (make up does this for you if .env is missing). Never commit .env.

# LLM providers (needed from prompt 07 on; M1 never calls them)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local tools (uv run ...) talk to the Compose services on localhost.
# Containers get their own host names from docker-compose.yml.
POSTGRES_USER=quarterly
POSTGRES_PASSWORD=quarterly
POSTGRES_DB=quarterly
DATABASE_URL=postgresql+psycopg://quarterly:quarterly@localhost:5432/quarterly
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=quarterly
MINIO_ROOT_PASSWORD=quarterly-dev-secret
MINIO_BUCKET=snapshots

# Secrets: replace with long random values outside development
# (python -c "import secrets; print(secrets.token_urlsafe(48))")
SERVER_HMAC_KEY=dev-only-server-hmac-key
ISSUANCE_HMAC_KEY=dev-only-issuance-hmac-key
SESSION_SECRET=dev-only-session-secret

# Development only: show program versions that are still in review (M1 seed data).
SHOW_UNPUBLISHED_PROGRAMS=true

# Accounts. The session cookie is Secure by default; turn that off only for local http.
SESSION_COOKIE_SECURE=false
# console prints verification codes to the API's stdout (never the address); smtp sends mail.
EMAIL_BACKEND=console
# EMAIL_FROM=Quarterly <no-reply@example.edu>
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=
# Reverse proxies that append the client address to X-Forwarded-For (rate limits only).
TRUSTED_PROXY_HOPS=0
