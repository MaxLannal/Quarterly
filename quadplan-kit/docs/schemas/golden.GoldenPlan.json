        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "program_id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Program Id",
          "type": "string"
        },
        "scope": {
          "default": "career",
          "enum": [
            "career",
            "term"
          ],
          "title": "Scope",
          "type": "string"
        },
        "term": {
          "anyOf": [
            {
              "examples": [
                "2026-AU"
              ],
              "pattern": "^\\d{4}-(AU|WI|SP|SU)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term"
        },
        "type": {
          "const": "bxms",
          "default": "bxms",
          "title": "Type",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "program_id",
        "apply_by"
      ],
      "title": "BxmsGoal",
      "type": "object"
    },
