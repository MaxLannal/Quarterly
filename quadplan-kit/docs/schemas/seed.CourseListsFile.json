{
  "$defs": {
    "CourseList": {
      "additionalProperties": false,
      "description": "A named list per catalog year. Members = `courses` plus every course of `sublists`.\nA list of sequences (e.g. `core-huma-sequences`) has one sublist per sequence.",
      "properties": {
        "courses": {
          "items": {
            "examples": [
              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Courses",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Name",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sublists": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Sublists",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CourseList",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a rule came from. `quote` is copied verbatim from the page.",
      "properties": {
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "quote"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "course_lists": {
      "items": {
        "$ref": "#/$defs/CourseList"
      },
      "title": "Course Lists",
      "type": "array"
    }
  },
  "required": [
    "course_lists"
  ],
  "title": "CourseListsFile",
  "type": "object"
}
