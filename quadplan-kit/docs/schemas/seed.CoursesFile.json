{
  "$defs": {
    "Atom": {
      "additionalProperties": false,
      "description": "`course`: met by a course completed, credited or planned in a strictly earlier term.\n`concurrent`: same or earlier term. `placement`/`standing`: plan facts.\n`program`: enrolment restriction (glob on program ids, e.g. `cmsc-*`).\n`consent`: never blocks; always produces a warning.",
      "properties": {
        "kind": {
          "enum": [
            "course",
            "concurrent",
            "placement",
            "standing",
            "program",
            "consent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min_grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Grade"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Atom",
      "type": "object"
    },
    "Expr": {
      "additionalProperties": false,
      "description": "Canonical form: `{op, n, children, atom}`. Shorthand accepted on input:\n`\"CMSC 14100\"`, `{course: X, min_grade: G}`, `{concurrent: X}`, `{placement: X}`,\n`{standing: X}`, `{program: X}`, `{consent: X}`, `{all: [...]}`, `{any: [...]}`,\n`{n_of: k, of: [...]}`.",
      "properties": {
        "atom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Atom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Expr"
          },
          "title": "Children",
          "type": "array"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "op": {
          "enum": [
            "all",
            "any",
            "n_of",
            "atom"
          ],
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Expr",
      "type": "object"
    },
    "SeedCourse": {
      "additionalProperties": false,
      "description": "One CourseLeaf course block, copied by hand.",
      "properties": {
        "code": {
          "examples": [
            "CMSC 14100"
          ],
          "pattern": "^[A-Z]{2,5} \\d{5}$",
          "title": "Code",
          "type": "string"
        },
        "core_tags": {
          "items": {
            "type": "string"
          },
          "title": "Core Tags",
          "type": "array"
        },
        "coreq": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crosslists": {
          "items": {
            "examples": [
              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Crosslists",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "equivalents": {
          "items": {
            "examples": [
              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Equivalents",
          "type": "array"
        },
        "mutually_exclusive": {
          "items": {
            "examples": [
              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Mutually Exclusive",
          "type": "array"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "prereq": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prereq_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prereq Text"
        },
        "repeatable": {
          "default": false,
          "title": "Repeatable",
          "type": "boolean"
        },
        "replaces": {
          "items": {
            "examples": [
              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Replaces",
          "type": "array"
        },
        "restrictions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "terms_offered": {
          "items": {
            "enum": [
              "AU",
              "WI",
              "SP",
              "SU"
            ],
            "type": "string"
          },
          "title": "Terms Offered",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "units": {
          "default": 100,
          "minimum": 0,
          "title": "Units",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "title",
        "source"
      ],
      "title": "SeedCourse",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a rule came from. `quote` is copied verbatim from the page.",
      "properties": {
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "quote"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "courses": {
      "items": {
        "$ref": "#/$defs/SeedCourse"
      },
      "title": "Courses",
      "type": "array"
    }
  },
  "required": [
    "courses"
  ],
  "title": "CoursesFile",
  "type": "object"
}
