              "CMSC 14100"
            ],
            "pattern": "^[A-Z]{2,5} \\d{5}$",
            "type": "string"
          },
          "title": "Courses",
          "type": "array"
        },
        "node": {
          "title": "Node",
          "type": "string"
        }
      },
      "required": [
        "node",
        "courses"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "GoalResult": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "title": "Goal",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "goal",
        "pass"
      ],
      "title": "GoalResult",
      "type": "object"
