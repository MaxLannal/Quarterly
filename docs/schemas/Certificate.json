      "required": [
        "term",
        "units"
      ],
      "title": "LoadEntry",
      "type": "object"
    },
    "PrereqWitness": {
      "additionalProperties": false,
      "description": "`by` entries: `\"CODE@TERM\"` (a plan item), `\"credit:CODE\"`, `\"placement:VALUE\"`,\n`\"standing:VALUE\"`, `\"program:ID\"` or `\"consent:VALUE\"`.",
      "properties": {
        "by": {
          "items": {
            "type": "string"
          },
          "title": "By",
          "type": "array"
        },
        "course": {
          "examples": [
            "CMSC 14100"
          ],
          "pattern": "^[A-Z]{2,5} \\d{5}$",
          "title": "Course",
          "type": "string"
        },
        "term": {
          "examples": [
            "2026-AU"
          ],
          "pattern": "^\\d{4}-(AU|WI|SP|SU)$",
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "course",
        "term",
        "by"
      ],
      "title": "PrereqWitness",
      "type": "object"
